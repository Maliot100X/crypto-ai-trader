# Solana Agent Trader - Environment Configuration
# Copy to .env and fill in your values

# === REQUIRED ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# === LLM PROVIDERS (at least one recommended) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
FIREWORKS_API_KEY=

# Ollama (local LLM)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Fireworks AI
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
FIREWORKS_MODEL=accounts/fireworks/routers/kimi-k2p5-turbo

# === DATABASE ===
DATABASE_URL=postgresql://postgres:password@localhost:5432/solana_trader
REDIS_URL=redis://localhost:6379

# === API SERVER ===
API_HOST=0.0.0.0
API_PORT=8080

# === DASHBOARD ===
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080

# === TRADING ===
TRADING_MODE=simulation
INITIAL_CAPITAL=10000
MAX_POSITION_PCT=0.1
STOP_LOSS_PCT=0.03
TAKE_PROFIT_PCT=0.06
